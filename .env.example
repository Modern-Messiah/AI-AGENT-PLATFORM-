# --- Postgres ---
# Docker Compose publishes development ports to localhost by default. Set
# HOST_BIND_ADDRESS=0.0.0.0 only if you intentionally want LAN access.
HOST_BIND_ADDRESS=127.0.0.1

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=app
# Runtime role used by api/worker. Migrations create this role and grant only
# application table privileges, so Row-Level Security is not bypassed.
APP_DB_USER=aap_app
APP_DB_PASSWORD=

# --- ClickHouse ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=analytics

# --- MinIO ---
MINIO_ROOT_USER=aap_minio
MINIO_ROOT_PASSWORD=

# --- Langfuse ---
# Generate secrets locally. Examples:
#   openssl rand -hex 32
#   openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# 64 hex chars (32 bytes); generate: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=

# Get these from Langfuse UI after first login (Project Settings → API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- LLM providers ---
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
# Required when APP_ENV is not local. Use comma-separated origins or JSON array.
# Wildcard "*" is rejected outside local.
# ALLOWED_ORIGINS=https://app.example.com
# Protects POST /auth/keys.
ADMIN_SECRET=

# Optional local UI auth. This key is bundled into the browser build, so use it
# only for local/private deployments. It is NOT the provider key below.
VITE_API_BASE_URL=/api
VITE_API_KEY=

# Model identifiers in provider/model format
# strong = сложные задачи (reasoning, tool-calling, structured output)
# weak   = дешёвые/простые шаги (классификация, summarization, парсинг)
STRONG_MODEL=moonshot/kimi-k2.6
WEAK_MODEL=deepseek/deepseek-v4-flash
# Vision fallback for scanned pages, diagrams, tables, and images
VISION_MODEL=moonshot/kimi-k2.6

# Multilingual (~50 languages incl. Russian) embedding model. The previous
# default BAAI/bge-small-en-v1.5 was English-only and degraded Russian recall.
# Same 384-dim output → no schema migration, but reindex every document after
# switching (vectors of different models are incompatible even at equal dim):
# see docs/runbooks/reindex-after-embedding-change.md
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Must match the model output dimension. Quality upgrade: intfloat/
# multilingual-e5-large (1024d) — resize the vector column per the runbook.
EMBEDDING_DIM=384
# How many texts the worker embeds per FastEmbed batch call (memory knob).
EMBEDDING_BATCH_SIZE=256

# Chunking (worker). 2000 chars ≈ 350–700 tokens depending on language.
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# OCR and page rendering
# PaddleOCR language(s), comma-separated for mixed-script documents
# (e.g. "ru,en" — every engine runs per page, best result wins).
OCR_LANGUAGE=ru
VISUAL_RENDER_MAX_DIMENSION=1800
URL_SOURCE_MAX_BYTES=10485760
URL_SOURCE_MAX_IMAGES=8
GITHUB_SOURCE_MAX_IMAGES=24
URL_SOURCE_IMAGE_MAX_BYTES=5242880
# Test-only: lets live e2e tests fetch a fixture page from host.docker.internal.
# Keep false for normal local use and any shared deployment.
E2E_ALLOW_LOCAL_URL_SOURCES=false

# Agent guardrails
AGENT_QUERY_MAX_CHARS=12000
AGENT_RATE_LIMIT_PER_MINUTE=20
# true: reject agent requests (503) when Redis is down instead of running
# unlimited (default fail-open).
RATE_LIMIT_FAIL_CLOSED=false
# Delete chat sessions idle for longer than N days (0 = keep forever).
CHAT_SESSION_RETENTION_DAYS=0
LLM_TIMEOUT_SECONDS=60
BUDGET_ALERT_USD_PER_CALL=0.10
# Comma-separated or JSON array. Leave empty for private local use; set it for
# shared/LAN deployments to prevent SSRF/DNS-rebinding surprises.
HTTP_FETCH_ALLOWED_DOMAINS=
ENABLE_CODE_EXEC=false
# Docker sandbox image for code_exec (e.g. python:3.12-slim). Empty = hardened
# host subprocess; set to isolate snippets in a no-network container.
# NOTE: needs docker CLI + daemon socket in the executing process — true for
# a host-run worker (make worker), NOT for the compose worker container.
CODE_EXEC_SANDBOX_IMAGE=
# HITL reviewer notification (Slack-compatible JSON webhook). Empty = log only.
HITL_WEBHOOK_URL=
# Optional public base URL for approve links in the notification message.
HITL_WEBHOOK_BASE_URL=
MAX_UPLOAD_BYTES=52428800
MAX_BULK_TOTAL_BYTES=209715200
RETRIEVAL_MAX_DISTANCE=0.75
# Top-K for the durable agent's retrieve tool (streaming path uses FAST_RAG_*).
RETRIEVAL_TOP_K=5
FAST_RAG_CANDIDATE_K=12
SCOPED_RAG_CANDIDATE_K=32
FAST_RAG_TOP_K=6
FAST_RAG_PER_DOCUMENT_K=2
FAST_RAG_CONTEXT_MAX_CHARS=16000
# Hybrid retrieval: fuse vector search with PostgreSQL full-text matches.
# Set to false to fall back to pure vector search.
HYBRID_SEARCH_ENABLED=true

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-tasks

# NOTE (2026-09): MinIO removed the server image from Docker Hub and gated
# quay.io pulls. The compose file pins bitnamilegacy/minio (last freely
# pullable build, same binary/API). For production prefer your own pinned
# mirror or MinIO's gated releases.

# --- Optional TLS termination (docker compose --profile tls up -d) ---
# TLS_DOMAIN=example.com gets a Let's Encrypt cert (TLS_EMAIL required);
# empty TLS_DOMAIN uses Caddy's internal CA (self-signed, fine for LAN).
TLS_DOMAIN=
TLS_EMAIL=

# --- Storage ---
DATABASE_URL=postgresql+asyncpg://aap_app:REPLACE_WITH_APP_DB_PASSWORD@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
CLICKHOUSE_URL=http://default:REPLACE_WITH_CLICKHOUSE_PASSWORD@localhost:8123/analytics
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=aap_minio
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_ROOT_PASSWORD
MINIO_BUCKET=app-files
# True when MinIO is reachable over TLS (reverse proxy / stunnel in front).
MINIO_SECURE=false
