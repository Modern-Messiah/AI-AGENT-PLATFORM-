# --- Postgres ---
# Docker Compose publishes development ports to localhost by default. Set
# HOST_BIND_ADDRESS=0.0.0.0 only if you intentionally want LAN access.
HOST_BIND_ADDRESS=127.0.0.1

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=app
# Runtime role used by api/worker. Migrations create this role and grant only
# application table privileges, so Row-Level Security is not bypassed.
APP_DB_USER=aap_app
APP_DB_PASSWORD=

# --- ClickHouse ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=analytics

# --- MinIO ---
MINIO_ROOT_USER=aap_minio
MINIO_ROOT_PASSWORD=

# --- Langfuse ---
# Generate secrets locally. Examples:
#   openssl rand -hex 32
#   openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# 64 hex chars (32 bytes); generate: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=

# Get these from Langfuse UI after first login (Project Settings → API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- LLM providers ---
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
# Required when APP_ENV is not local. Use comma-separated origins or JSON array.
# Wildcard "*" is rejected outside local.
# ALLOWED_ORIGINS=https://app.example.com
# Protects POST /auth/keys.
ADMIN_SECRET=

# Optional local UI auth. This key is bundled into the browser build, so use it
# only for local/private deployments. It is NOT the provider key below.
VITE_API_BASE_URL=/api
VITE_API_KEY=

# Model identifiers in provider/model format
# strong = сложные задачи (reasoning, tool-calling, structured output)
# weak   = дешёвые/простые шаги (классификация, summarization, парсинг)
STRONG_MODEL=moonshot/kimi-k2.6
WEAK_MODEL=deepseek/deepseek-v4-flash
# Vision fallback for scanned pages, diagrams, tables, and images
VISION_MODEL=moonshot/kimi-k2.6

# Default is backward-compatible with existing indexes. For stronger Russian
# retrieval, use sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# and reindex every existing document before mixing old and new vectors.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# OCR and page rendering
# PaddleOCR language model. "ru" recognizes Russian and English text.
OCR_LANGUAGE=ru
VISUAL_RENDER_MAX_DIMENSION=1800
URL_SOURCE_MAX_BYTES=10485760
URL_SOURCE_MAX_IMAGES=8
GITHUB_SOURCE_MAX_IMAGES=24
URL_SOURCE_IMAGE_MAX_BYTES=5242880
# Test-only: lets live e2e tests fetch a fixture page from host.docker.internal.
# Keep false for normal local use and any shared deployment.
E2E_ALLOW_LOCAL_URL_SOURCES=false

# Agent guardrails
AGENT_QUERY_MAX_CHARS=12000
AGENT_RATE_LIMIT_PER_MINUTE=20
LLM_TIMEOUT_SECONDS=60
BUDGET_ALERT_USD_PER_CALL=0.10
# Comma-separated or JSON array. Leave empty for private local use; set it for
# shared/LAN deployments to prevent SSRF/DNS-rebinding surprises.
HTTP_FETCH_ALLOWED_DOMAINS=
ENABLE_CODE_EXEC=false
MAX_UPLOAD_BYTES=52428800
MAX_BULK_TOTAL_BYTES=209715200
RETRIEVAL_MAX_DISTANCE=0.75
FAST_RAG_CANDIDATE_K=12
FAST_RAG_TOP_K=6
FAST_RAG_PER_DOCUMENT_K=2
FAST_RAG_CONTEXT_MAX_CHARS=8000

# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-tasks

# --- Storage ---
DATABASE_URL=postgresql+asyncpg://aap_app:REPLACE_WITH_APP_DB_PASSWORD@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
CLICKHOUSE_URL=http://default:REPLACE_WITH_CLICKHOUSE_PASSWORD@localhost:8123/analytics
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=aap_minio
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_ROOT_PASSWORD
MINIO_BUCKET=app-files
