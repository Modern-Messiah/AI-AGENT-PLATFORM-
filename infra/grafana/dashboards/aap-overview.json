{
  "title": "AI Agent Platform — Overview",
  "uid": "aap-overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum by (path) (rate(aap_http_requests_total[5m]))", "legendFormat": "{{path}}" }
      ]
    },
    {
      "id": 2,
      "title": "Request latency p95 (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(aap_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(aap_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" }
      ]
    },
    {
      "id": 3,
      "title": "LLM tokens by model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum by (model, kind) (rate(aap_agent_tokens_total[5m])) * 60", "legendFormat": "{{model}} {{kind}}/min" }
      ]
    },
    {
      "id": 4,
      "title": "Semantic cache hit ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(aap_agent_cache_requests_total{result=\"hit\"}[15m])) / clamp_min(sum(rate(aap_agent_cache_requests_total[15m])), 0.000001)", "legendFormat": "hit ratio" }
      ]
    },
    {
      "id": 5,
      "title": "HTTP 5xx rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(rate(aap_http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx/s" }
      ]
    }
  ]
}
